# WhatsApp Business (E.164, e.g. 2348012345678). Floating button hidden until set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Partner logo preview (shows sourced marks without production approval).
# Enable on local/staging only. Never set true on production without legal sign-off.
NEXT_PUBLIC_PARTNER_LOGO_PREVIEW=true


# Enquiry delivery
# - unset / anything other than provider|mock: production-safe "not configured" response
# - mock: accept locally and log minimal metadata (never enable in production)
# - provider: POST JSON to ENQUIRY_WEBHOOK_URL
ENQUIRY_MODE=mock
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
